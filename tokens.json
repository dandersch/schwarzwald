        "setup": [
          ";; Fill C syntax gaps without enabling a parser or changing major modes.",
          "(require 'rx)",
          "(defconst doom-custom--c-number-pattern",
          "  (rx (or (seq symbol-start digit) (seq \".\" digit))",
          "      (* (or (seq (any \"eEpP\") (any \"+-\")) (any alnum \"_.\")))))",
          "(defconst doom-custom--c-number-keywords",
          "  `((,doom-custom--c-number-pattern (0 'font-lock-number-face))))",
          "(defun doom-custom--macro-numbers (node override start end &rest _)",
          "  (save-excursion",
          "    (goto-char (max start (treesit-node-start node)))",
          "    (while (re-search-forward doom-custom--c-number-pattern",
          "                              (min end (treesit-node-end node)) t)",
          "      (let ((beg (match-beginning 0)) (fin (match-end 0)))",
          "        (unless (nth 8 (save-excursion (syntax-ppss beg)))",
          "          (treesit-fontify-with-override beg fin 'font-lock-number-face",
          "                                         override start end))))))",
          "(defun doom-custom--c-highlighting (&rest _)",
          "  (dolist (buffer (buffer-list))",
          "    (with-current-buffer buffer",
          "      (when (derived-mode-p 'c-mode 'c++-mode 'c-ts-mode 'c++-ts-mode)",
          "        (let ((active (memq 'doom-custom custom-enabled-themes)))",
          "          (if (derived-mode-p 'c-ts-mode 'c++-ts-mode)",
          "              (progn",
          "                (setq-local treesit-font-lock-settings",
          "                            (cl-remove-if (lambda (rule) (eq (nth 2 rule) 'schwarzwald))",
          "                                          treesit-font-lock-settings))",
          "                (when active",
          "                  (setq-local treesit-font-lock-settings",
          "                    (append treesit-font-lock-settings",
          "                      (treesit-font-lock-rules",
          "                        :language (if (derived-mode-p 'c++-ts-mode) 'cpp 'c)",
          "                        :feature 'schwarzwald :override t",
          "                        `((preproc_def name: (identifier) @font-lock-preprocessor-face)",
          "                          (preproc_function_def name: (identifier) @font-lock-preprocessor-face)",
          "                          ((identifier) @font-lock-constant-face",
          "                           (:match ,(rx string-start upper (+ (any upper digit \"_\")) string-end)",
          "                                   @font-lock-constant-face))",
          "                          (enumerator name: (identifier) @font-lock-constant-face)",
          "                          (char_literal) @font-lock-string-face",
          "                          (preproc_arg) @doom-custom--macro-numbers)))))",
          "                (treesit-font-lock-recompute-features",
          "                  (when active '(schwarzwald)) (unless active '(schwarzwald))))",
          "            (font-lock-remove-keywords nil doom-custom--c-number-keywords)",
          "            (when active",
          "              (font-lock-add-keywords nil doom-custom--c-number-keywords 'append)))",
          "          (when font-lock-mode (font-lock-flush)))))))",
          "(dolist (hook '(c-mode-hook c++-mode-hook c-ts-mode-hook c++-ts-mode-hook",
          "                enable-theme-functions disable-theme-functions))",
          "  (add-hook hook #'doom-custom--c-highlighting))"
        ]
      },
